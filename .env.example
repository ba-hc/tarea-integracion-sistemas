# Local demo values only. Replace both API keys outside local development.
API_KEY_READER=local-reader-key-for-demo
API_KEY_OPERATOR=local-operator-key-for-demo

# Set both when using the experiment profile:
# INVENTORY_GRPC_URL=toxiproxy:50051
# INVENTORY_RPC_DEADLINE_MS=800

# Cambia si el puerto local 5433 ya está ocupado (solo perfil de test).
SALES_TEST_DB_PORT=5433

# Secreto del JWT del API Gateway (>= 32 bytes). El docker-compose.yml trae un
# valor de demo local; sustitúyelo fuera de una máquina de desarrollo.
# GATEWAY_JWT_SECRET=
# Puerto del host donde se publica el Gateway (único puerto publicado).
# GATEWAY_PUBLISHED_PORT=8080
