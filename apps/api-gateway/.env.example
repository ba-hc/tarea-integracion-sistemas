# Local non-Docker example. Never commit a real GATEWAY_JWT_SECRET.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_SALES_BASE_URL=http://127.0.0.1:3000
GATEWAY_BFF_BASE_URL=http://127.0.0.1:3002
GATEWAY_JWT_SECRET=
GATEWAY_JWT_ISSUER=repuestossur-demo
GATEWAY_JWT_AUDIENCE=repuestossur-gateway
GATEWAY_SALES_API_KEY_READER=local-reader-key-for-demo
GATEWAY_SALES_API_KEY_OPERATOR=local-operator-key-for-demo
GATEWAY_SALES_TIMEOUT_MS=10000
GATEWAY_BFF_TIMEOUT_MS=2500
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX_REQUESTS=60
GATEWAY_RATE_LIMIT_MAX_IDENTITIES=10000
GATEWAY_MAX_REQUEST_BODY_BYTES=1048576
GATEWAY_MAX_RESPONSE_BODY_BYTES=2097152
