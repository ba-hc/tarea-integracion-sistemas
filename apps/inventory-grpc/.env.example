# Conexión a la base PROPIA de Inventory (nunca la de Sales).
DATABASE_URL=postgresql://inventory:inventory@localhost:55432/inventory?schema=public

# Dirección donde escucha el servidor gRPC.
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Opcional: ruta al .proto congelado. Por defecto se usa
# <repo>/contracts/grpc/repuestossur/inventory/v1/inventory.proto
# INVENTORY_PROTO_PATH=

# Sólo pruebas de integración: base desechable (su nombre debe contener "test").
TEST_DATABASE_URL=postgresql://inventory:inventory@localhost:55432/inventory_test?schema=public
